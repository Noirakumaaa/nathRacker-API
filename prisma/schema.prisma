generator client {
  provider = "prisma-client"
  output   = "./generated"
  //engineType = "client"
}

datasource db {
  provider = "postgresql"
}

// ─── Enums ────────────────────────────────────────────────────────────────────

enum Role {
  ENCODER
  ADMIN
  AC
  SWOIII
  VERIFIER
}

enum theme {
  LIGHT
  DARK
}

// ─── Lookup / Reference Models ────────────────────────────────────────────────

model OperationsOfficeNum {
  id               Int               @id @default(autoincrement())
  name             String
  lgu              Lgu[]
  userInfo         UserInfo[]
  bus              Bus[]
  swdi             Swdi[]
  pcn              Pcn[]
  cvs              CVS[]
  miscellaneous    Miscellaneous[]
  encodedDocuments EncodedDocument[]
}

model Lgu {
  id                    Int                 @id @default(autoincrement())
  name                  String
  operationsOfficeNumId Int
  operationsOfficeNum   OperationsOfficeNum @relation(fields: [operationsOfficeNumId], references: [id])
  barangay              Barangay[]
  userInfo              UserInfo[]
}

model Barangay {
  id       Int        @id @default(autoincrement())
  name     String
  lguId    Int
  lgu      Lgu        @relation(fields: [lguId], references: [id])
  userInfo UserInfo[]
}

// ─── User Models ──────────────────────────────────────────────────────────────

model User {
  id               Int               @id @default(autoincrement())
  email            String            @unique
  password         String
  govUsername      String            @unique
  role             Role              @default(ENCODER)
  createdAt        DateTime          @default(now())
  userInfo         UserInfo?
  busById          Bus[]             @relation("UserById")
  swdiByID         Swdi[]            @relation("UserById")
  pcnByID          Pcn[]             @relation("UserById")
  cvsByID          CVS[]             @relation("UserById")
  miscByID         Miscellaneous[]   @relation("UserById")
  encDocByID       EncodedDocument[] @relation("UserById")
  encDocByUsername EncodedDocument[] @relation("UserByUsername")
}

model UserInfo {
  id                  Int                  @id @default(autoincrement())
  userId              Int                  @unique
  firstName           String               @default("")
  lastName            String               @default("")
  middleName          String               @default("")
  phone               String               @default("")
  sessionTime         Int                  @default(30)
  language            String               @default("ENGLISH")
  timezone            String               @default("UTC")
  theme               theme                @default(DARK)
  twoFactorAuth       Boolean              @default(false)
  smsAlert            Boolean              @default(false)
  loginAlert          Boolean              @default(false)
  SecuritAlert        Boolean              @default(false)
  emailAlert          Boolean              @default(false)
  weeklyReportAlert   Boolean              @default(false)
  assignedOperationId Int?
  assignedLGUID       Int?
  assignedBarangayId  Int?
  user                User                 @relation(fields: [userId], references: [id])
  assignedArea        OperationsOfficeNum? @relation(fields: [assignedOperationId], references: [id])
  assignedLgu         Lgu?                 @relation(fields: [assignedLGUID], references: [id])
  assignedBarangay    Barangay?            @relation(fields: [assignedBarangayId], references: [id])
}

// ─── Data Models ──────────────────────────────────────────────────────────────

model Bus {
  id                    Int                  @id @default(autoincrement())
  hhId                  String
  lgu                   String
  barangay              String
  granteeName           String
  typeOfUpdate          String
  subjectOfChange       String
  drn                   String
  cl                    String
  date                  DateTime
  encodedBy             String
  updateInfo            String
  remarks               String
  note                  String?
  issue                 String?
  verificationIssue     String?
  verifiedBy            String               @default("")
  verified              String               @default("NO")
  userId                Int
  operationsOfficeNumId Int?
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt
  userById              User                 @relation("UserById", fields: [userId], references: [id])
  operationsOffice      OperationsOfficeNum? @relation(fields: [operationsOfficeNumId], references: [id])

  @@index([hhId])
}

model Swdi {
  id                    Int                  @id @default(autoincrement())
  hhId                  String
  lgu                   String
  barangay              String
  grantee               String
  swdiScore             Float
  swdiLevel             String
  drn                   String?
  cl                    String?
  date                  DateTime
  encodedBy             String
  remarks               String
  note                  String?
  issue                 String?
  verifiedBy            String               @default("")
  verified              String               @default("NO")
  userId                Int
  operationsOfficeNumId Int?
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt
  userById              User                 @relation("UserById", fields: [userId], references: [id])
  operationsOffice      OperationsOfficeNum? @relation(fields: [operationsOfficeNumId], references: [id])

  @@index([hhId])
}

model Pcn {
  id                    Int                  @id @default(autoincrement())
  hhId                  String
  lgu                   String?
  barangay              String?
  granteeName           String?
  subjectOfChange       String
  pcn                   String?
  lrn                   String?
  drn                   String?
  cl                    String?
  date                  DateTime
  encodedBy             String
  remarks               String
  note                  String?
  issue                 String?
  verifiedBy            String               @default("")
  verified              String               @default("NO")
  userId                Int
  operationsOfficeNumId Int?
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt
  userById              User                 @relation("UserById", fields: [userId], references: [id])
  operationsOffice      OperationsOfficeNum? @relation(fields: [operationsOfficeNumId], references: [id])

  @@index([hhId])
  @@index([granteeName])
}

model CVS {
  id                    Int                  @id @default(autoincrement())
  idNumber              String
  lgu                   String
  barangay              String
  facilityName          String
  formType              String
  period                String
  date                  DateTime
  remarks               String
  issue                 String?
  userId                Int
  operationsOfficeNumId Int?
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt
  userById              User                 @relation("UserById", fields: [userId], references: [id])
  operationsOffice      OperationsOfficeNum? @relation(fields: [operationsOfficeNumId], references: [id])

  @@index([id])
  @@index([idNumber])
}

model Miscellaneous {
  id                    Int                  @id @default(autoincrement())
  hhId                  String
  lgu                   String
  barangay              String
  granteeName           String
  documentType          String
  subjectOfChange       String?
  drn                   String?
  cl                    String?
  date                  DateTime
  encodedBy             String
  remarks               String
  note                  String?
  issue                 String?
  userId                Int
  operationsOfficeNumId Int?
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt
  userById              User                 @relation("UserById", fields: [userId], references: [id])
  operationsOffice      OperationsOfficeNum? @relation(fields: [operationsOfficeNumId], references: [id])

  @@index([id])
}

model EncodedDocument {
  id                    Int                  @id @default(autoincrement())
  idNumber              String               @default("")
  name                  String
  documentType          String
  documentId            Int                  @unique
  subjectOfChange       String
  drn                   String
  date                  DateTime
  govUsername           String
  remarks               String
  verifiedBy            String               @default("")
  verified              String               @default("NO")
  userId                Int
  operationsOfficeNumId Int?
  createdAt             DateTime             @default(now())
  userById              User                 @relation("UserById", fields: [userId], references: [id])
  govUserByUsername     User                 @relation("UserByUsername", fields: [govUsername], references: [govUsername])
  operationsOffice      OperationsOfficeNum? @relation(fields: [operationsOfficeNumId], references: [id])

  @@index([id])
  @@index([documentId])
}
