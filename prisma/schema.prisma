// ─── AA Document Tracking Module ──────────────────────────────────────────────

model AaDocumentModule {
  id          String       @id @default(uuid())
  code        String       @unique // e.g. "BDM", "CVS", "EDTMS"
  name        String // Full display name
  prefix      String // Used in trackingNo generation
  description String?
  isActive    Boolean      @default(true)
  // Column name mappings for Excel import (null = auto-detect by keyword)
  colStaff    String? // e.g. "Name of Staff", "Recipient"
  colSubject  String? // e.g. "Title of Documents", "Particulars"
  colActivity String? // e.g. "Activity Documentation"
  documents   AaDocument[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

model AaDocument {
  id            String            @id @default(uuid())
  trackingNo    String            // "BDM-0001" — unique per module+year, not globally
  sequence      Int // Per-module counter (never reused)
  staffName     String
  subject       String            @db.Text
  operationNum  String? // OO number this document belongs to
  year          Int     @default(2026)
  dateCreated   DateTime
  moduleId      String
  module        AaDocumentModule  @relation(fields: [moduleId], references: [id])
  remarks       AaRemark[]
  load26Monthly  AaLoad26Monthly?
  coaWtr26       CoaWTr2026?      @relation("CoaWTr2026Document")
  hazard26       Hazard2026?      @relation("Hazard2026Document")
  tev26          Tev2026?         @relation("Tev2026Document")
  magna26        MagnaCarta2026?  @relation("MagnaCarta2026Document")
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@unique([moduleId, year, sequence])
  @@unique([moduleId, year, trackingNo])
  @@index([moduleId, year, dateCreated])
  @@index([staffName])
}

