model EncodedDocument {
  id                    Int                  @id @default(autoincrement())
  idNumber              String               @default("")
  name                  String
  documentType          String
  documentId            Int
  subjectOfChange       String
  drn                   String
  date                  DateTime
  govUsername           String
  typeOfUpdate          String?
  remarks               String
  verifiedBy            String               @default("")
  verified              String               @default("NO")
  userId                Int
  operationsOfficeNumId Int?
  createdAt             DateTime             @default(now())
  userById              User                 @relation("UserById", fields: [userId], references: [id])
  govUserByUsername     User                 @relation("UserByUsername", fields: [govUsername], references: [govUsername])
  operationsOffice      OperationsOfficeNum? @relation(fields: [operationsOfficeNumId], references: [id])

  @@index([id])
  @@index([documentId])
}

// ─── AA Document Tracking Module ──────────────────────────────────────────────

model AaDocumentModule {
  id          String       @id @default(uuid())
  code        String       @unique // e.g. "BDM", "CVS", "EDTMS"
  name        String // Full display name
  prefix      String // Used in trackingNo generation
  description String?
  isActive    Boolean      @default(true)
  isMonthly   Boolean      @default(false)
  // Column name mappings for Excel import (null = auto-detect by keyword)
  colStaff    String? // e.g. "Name of Staff", "Recipient"
  colSubject  String? // e.g. "Title of Documents", "Particulars"
  colActivity String? // e.g. "Activity Documentation"
  documents   AaDocument[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

model AaDocument {
  id            String            @id @default(uuid())
  trackingNo    String            // "BDM-0001" — unique per module+year, not globally
  sequence      Int // Per-module counter (never reused)
  staffName     String
  subject       String            @db.Text
  operationNum      String? // OO number this document belongs to
  year              Int
  dateCreated       DateTime
  dateSubmittedJnt  DateTime?
  oo8Level          String?   // GRS-specific: OO8 level classification
  moduleId          String
  module        AaDocumentModule  @relation(fields: [moduleId], references: [id])
  remarks       AaRemark[]
  monthlyData   AaMonthlyData?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@unique([moduleId, year, sequence])
  @@unique([moduleId, year, trackingNo])
  @@index([moduleId, year, dateCreated])
  @@index([staffName])
}

model AaMonthlyData {
  id         String     @id @default(uuid())
  documentId String     @unique
  document   AaDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  data       Json
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
}

model AaRemark {
  id         String     @id @default(uuid())
  documentId String
  document   AaDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  content    String     @db.Text
  remarkDate DateTime?
  order      Int // Ascending display order per document
  createdAt  DateTime   @default(now())

  @@index([documentId, order])
}

